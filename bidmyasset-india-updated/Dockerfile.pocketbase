# Builds a small image that runs PocketBase (SQLite-backed backend).
FROM alpine:3.20

ARG PB_VERSION=0.40.3

RUN apk add --no-cache ca-certificates unzip wget \
    && wget -O /tmp/pb.zip "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" \
    && unzip /tmp/pb.zip -d /pb \
    && rm /tmp/pb.zip \
    && chmod +x /pb/pocketbase

WORKDIR /pb

# Migrations (collections + seed data) get copied in so they run on first boot.
COPY pb_migrations ./pb_migrations

EXPOSE 8090
VOLUME ["/pb/pb_data"]

CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090"]
